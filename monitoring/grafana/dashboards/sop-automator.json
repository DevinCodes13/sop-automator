{
  "uid": "sop-automator",
  "title": "SOP Automator",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries", "title": "Requests per minute",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_requests_total[5m])) * 60", "legendFormat": "requests/min" }]
    },
    {
      "type": "timeseries", "title": "p95 response time",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" }]
    },
    {
      "type": "timeseries", "title": "Server errors (5xx %)",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 1e-9)", "legendFormat": "5xx %" }]
    },
    {
      "type": "stat", "title": "Runs finished (24h)",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status) (increase(runs_finished_total[24h]))", "legendFormat": "{{status}}" }]
    },
    {
      "type": "stat", "title": "Claude spend (24h)",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(increase(llm_cost_usd_total[24h]))", "legendFormat": "USD" }]
    },
    {
      "type": "stat", "title": "Claude p95 response time",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_latency_seconds_bucket[24h])))", "legendFormat": "p95" }]
    },
    {
      "type": "stat", "title": "Claude tokens (24h)",
      "gridPos": { "x": 0, "y": 14, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (kind) (increase(llm_tokens_total[24h]))", "legendFormat": "{{kind}}" }]
    },
    {
      "type": "stat", "title": "Claude calls by outcome (24h)",
      "gridPos": { "x": 8, "y": 14, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (outcome) (increase(llm_requests_total[24h]))", "legendFormat": "{{outcome}}" }]
    },
    {
      "type": "stat", "title": "Healthcare server (24h)",
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (increase(fhir_requests_total[24h]))", "legendFormat": "{{outcome}}" },
        { "refId": "B", "expr": "sum(increase(fhir_retries_total[24h]))", "legendFormat": "retries" }
      ]
    }
  ]
}
